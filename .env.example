# ==============================================================================
# VedioHooks AI Media Factory - Environment Configuration (.env.example)
# Copy this file to .env and adjust variables as desired.
# All features work 100% locally and FREE without any mandatory API keys!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OPTIONAL LLM VIRALITY SELECTOR ENGINES
# ------------------------------------------------------------------------------
# If left blank, the system uses the 100% FREE deterministic offline heuristic selector,
# evaluating hook strength, curiosity gaps, emotion, pacing, and story completeness.
GEMINI_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 2. 24/7 AUTONOMOUS SCHEDULER & CONCURRENCY
# ------------------------------------------------------------------------------
# Maximum simultaneous video rendering jobs on local CPU (default: 2)
MAX_CONCURRENT_JOBS=2

# Polling frequency in seconds for persistent SQLite queue (default: 3.0)
SCHEDULER_POLL_INTERVAL_SEC=3.0

# ------------------------------------------------------------------------------
# 3. FASTER-WHISPER SPEECH-TO-TEXT ENGINE
# ------------------------------------------------------------------------------
# Number of CPU threads dedicated to Whisper transcription (default: auto core count)
WHISPER_CPU_THREADS=12

# Suppress Hugging Face Windows symlink warnings
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# ------------------------------------------------------------------------------
# 4. FFMPEG & RENDERING PERFORMANCE
# ------------------------------------------------------------------------------
# Subprocess timeout in seconds to prevent zombie processes (default: 300s / 5min)
FFMPEG_TIMEOUT_SEC=300
FFPROBE_TIMEOUT_SEC=60

# FFmpeg encoding preset: ultrafast, superfast, veryfast, faster, fast, medium
# 'fast' provides an optimal balance between rendering speed and visual fidelity.
FFMPEG_PRESET=fast

# ------------------------------------------------------------------------------
# 5. OFFICIAL META INSTAGRAM GRAPH API (OPTIONAL GROUNDWORK)
# ------------------------------------------------------------------------------
# By default, publishing is DISABLED (false). Set to 'true' only after
# authorizing a Meta Professional Account with content publishing permissions.
ENABLE_INSTAGRAM_PUBLISHING=false
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
